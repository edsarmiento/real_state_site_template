# White-label site template — copy to `.env` per inmobiliaria / deploy.
# Never commit `.env`. Values below are fictional placeholders.

ACCOUNT_ID=123
API_URL=https://api.example.com

# Institutional contact (public catalog). Not listing contact_phone.
SITE_WHATSAPP_NUMBER=525512345678
SITE_WHATSAPP_MESSAGE=Hola, me interesa conocer más sobre sus inmuebles.
SITE_CONTACT_PHONE=+525512345678
SITE_CONTACT_EMAIL=contacto@agencia.example

# Social profiles — https only; hosts must be facebook.com / instagram.com.
SITE_INSTAGRAM_URL=https://www.instagram.com/agencia_ejemplo/
SITE_FACEBOOK_URL=https://www.facebook.com/agencia_ejemplo/
